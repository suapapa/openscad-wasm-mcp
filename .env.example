PORT=3333
HOST=0.0.0.0
WORKSPACE_DIR=/workspace
ARTIFACT_DIR=/workspace/artifacts
JOB_TMP_DIR=/tmp/openscad-jobs
MAX_RENDER_MS=30000
MAX_OUTPUT_MB=50
MAX_INPUT_MB=10
MAX_PARALLEL_JOBS=2
CLEANUP_JOBS=true
OPENSCAD_BACKEND=wasm
PUBLIC_BASE_URL=http://127.0.0.1:3333
PREVIEW_TTL_SECONDS=3600
PREVIEW_ENABLED=true
# Optional. When set, /mcp requires Authorization: Bearer <token>.
# MCP_AUTH_TOKEN=change-me-to-a-long-random-secret
